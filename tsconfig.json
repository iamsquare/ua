{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@docs/*": ["./docs/*"],
      "@test/*": ["./test/*"]
    }
  },
  "include": ["src", "test", "scripts", "tsdown.config.ts", "vitest.config.ts"],
  "exclude": ["dist", "docs", "node_modules"]
}
