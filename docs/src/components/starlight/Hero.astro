---
import { LinkButton } from '@astrojs/starlight/components';

import { HeroLiquidMetalLogo } from '@/components/HeroLiquidMetalLogo';
import { HeroMeshGradient } from '@/components/HeroMeshGradient';
import { InstallCommand } from '@/components/InstallCommand';
import { cn } from '@/lib/cn';
import { hasAtLeast, isNonNullish, map } from 'remeda';

import pkg from '@/repo-root/package.json';

const { tagline, actions = [] } = Astro.locals.starlightRoute.entry.data.hero || {};
---

<script is:inline>
  document.documentElement.setAttribute('data-page-pending', '');

  window.setTimeout(() => {
    if (document.documentElement.hasAttribute('data-page-ready')) return;

    document.documentElement.setAttribute('data-page-ready', '');
    document.documentElement.removeAttribute('data-page-pending');
  }, 2500);
</script>

<section class="mt-0 md:pt-45 relative grid text-center">
  <div
    class="pointer-events-none absolute top-0 -bottom-180 left-1/2 z-0 w-screen max-w-[100vw] -translate-x-1/2"
    aria-hidden="true"
  >
    <HeroMeshGradient client:only="react" />
  </div>
  <div
    class="relative z-10 grid min-h-[min(72svh,--spacing(640))] items-center justify-items-center pt-[clamp(--spacing(48),8svh,--spacing(80))] pb-[clamp(--spacing(40),6svh,--spacing(64))]"
  >
    <div class="grid max-w-736 justify-items-center gap-24">
      <div class="grid justify-items-center gap-12">
        <HeroLiquidMetalLogo client:only="react" />
        <h1
          id="_top"
          data-page-title
          class="max-w-[18ch] mt-20 font-display text-[clamp(2.25rem,6vw,3.75rem)] font-bold leading-tight tracking-tight text-gray-900 dark:text-white"
        >
          Parse User-Agents<br />
          <span class="text-accent-600 dark:text-accent-300">Get structured results</span>
        </h1>
        {
          isNonNullish(tagline) && (
            <p
              class="max-w-[46ch] font-mono text-[clamp(0.95rem,1.4vw,1.1rem)] leading-relaxed text-gray-600 dark:text-gray-400"
              set:html={tagline}
            />
          )
        }
      </div>
      {
        hasAtLeast(actions, 1) && (
          <div class="flex flex-wrap justify-center gap-12">
            {map(actions, ({ attrs = {}, icon, link: href, text, variant }) => {
              const { class: className, ...props } = attrs;

              return (
                <LinkButton
                  href={href}
                  variant={variant}
                  icon={icon?.name}
                  class={cn(
                    'rounded-sm px-18 py-11 font-sans font-semibold [&_svg]:size-16!',
                    className,
                  )}
                  {...props}
                >
                  {text}
                </LinkButton>
              );
            })}
          </div>
        )
      }
      <InstallCommand client:load sizeLabel="~16.7 kB min+gzip" />
      <div
        class="flex items-center justify-center gap-10 rounded-full border border-gray-300 bg-gray-100/80 px-6 py-6 text-xs sm:pl-6 sm:pr-14 dark:border-gray-700 dark:bg-gray-900/60"
      >
        <span
          class="rounded-full bg-accent-600 px-10 py-3 font-mono font-semibold tracking-wide text-white"
        >
          v{pkg.version}
        </span>
        <span class="font-sans text-gray-700 dark:text-gray-300"> Initial release! 🎉 </span>
      </div>
    </div>
  </div>
</section>
