---
import Default from '@astrojs/starlight/components/Footer.astro';

import LogoMark from '@/components/starlight/LogoMark.astro';

const isSplash = Astro.locals.starlightRoute.entry.data.template === 'splash';
const { siteTitle } = Astro.locals.starlightRoute;
---

{
  isSplash ? (
    <footer class="not-content splash-footer border-t border-gray-800 bg-gray-950 text-gray-300">
      <div class="mx-auto grid w-full max-w-[min(--spacing(720),100%)] justify-items-center gap-24 px-[clamp(--spacing(20),5vw,--spacing(48))] py-[clamp(--spacing(40),6vw,--spacing(64))]">
        <div class="flex flex-col items-center gap-12 text-white">
          <LogoMark class="size-40" aria-hidden="true" />
          <p class="font-display text-xl font-semibold tracking-tight">{siteTitle}</p>
        </div>
        <p class="text-center font-mono text-sm text-gray-500">
          Copyright © {new Date().getFullYear()} iamsquare. Licensed under{' '}
          <a
            href="https://github.com/iamsquare/ua/blob/master/LICENSE"
            class="text-gray-400 underline underline-offset-2 hover:text-gray-200"
          >
            MIT
          </a>
          .
        </p>
      </div>
    </footer>
  ) : (
    <Default>
      <slot />
    </Default>
  )
}
