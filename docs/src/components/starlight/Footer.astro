---
import Default from '@astrojs/starlight/components/Footer.astro';

const isSplash = Astro.locals.starlightRoute.entry.data.template === 'splash';
---

{
  isSplash ? (
    <footer class="not-content splash-footer border-t border-gray-800 bg-gray-950 text-gray-300">
      <div class="mx-auto grid w-full max-w-[min(60rem,100%)] gap-24 px-[clamp(20px,5vw,48px)] py-[clamp(2.5rem,6vw,4rem)]">
        <p class="text-center font-display text-xl font-semibold tracking-tight text-white">
          @iamsquare/ua
        </p>
        <p class="text-center font-mono text-[0.8rem] text-gray-500">
          Copyright © {new Date().getFullYear()} iamsquare. Licensed under{' '}
          <a
            href="https://github.com/iamsquare/ua/blob/master/LICENSE"
            class="text-gray-400 underline underline-offset-2 hover:text-gray-200"
          >
            MIT
          </a>
          .
        </p>
      </div>
    </footer>
  ) : (
    <Default>
      <slot />
    </Default>
  )
}
